<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted for LOOPBACK ONLY, so the in-app media
  proxy (LocalMediaServer) can serve the player over http://127.0.0.1.
  Traffic never leaves the device on that interface, so there is nothing
  to intercept; everything else stays HTTPS-only via base-config below.

  Without this Android >=28 blocks the proxy outright and every reel
  falls back to streaming from origin.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
